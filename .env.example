PORT=3000
DATABASE_URL=postgresql://user:password@host:5432/marketuz
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password
# DATABASE_SSL=true for external TLS connections; Render internal connections use false.
DATABASE_SSL=false
# Payments stay hidden until provider testing, legal details, and shipping included in price.
PAYMENTS_ENABLED=false
SHIPPING_INCLUDED_IN_PRICE=false
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
# Only enable after Click confirms the official inline widget for this merchant.
CLICK_MERCHANT_USER_ID=
CLICK_INLINE_ENABLED=false
PAYME_MERCHANT_ID=
PAYME_LOGIN=Paycom
PAYME_KEY=
# Telegram Mini App: run scripts/configure-telegram.mjs after deployment.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
MARKETUZ_URL=https://market.hallaym.com
DB_POOL_MAX=10

# Eskiz SMS OTP authentication (never enable SMS_MOCK in production)
SMS_ENABLED=false
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=4546
OTP_SECRET=replace-with-at-least-32-random-characters
